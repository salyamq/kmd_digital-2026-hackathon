      "items": [
        {
          "id": "how-1",
          "section": "Как работает модель",
          "text": "Для радиального горизонтального течения подставляют выражение дебита по закону Дарси. Дебит связан с градиентом давления, радиусом и толщиной. Его масштаб определяет отношение проницаемости к вязкости. В результате пространственное изменение градиента давления связано с изменением плотности во времени.",
          "claim_ids": [
            "geo.test_dake.s5_2.03.c01",
            "geo.test_dake.s5_2.03.c02",
            "geo.test_dake.s5_2.03.c03"
          ],
          "pages": [
            76
          ],
          "by": "author",
          "quotes": [
            {
              "claim_id": "geo.test_dake.s5_2.03.c01",
              "quote": "By applying Darcy's Law for radial, horizontal flow it is possible to substitute for the flow rate q in equ. (5.2) since",
              "page": 76,
              "kind": "observation"
            },
            {
              "claim_id": "geo.test_dake.s5_2.03.c02",
              "quote": "$$q = \\frac {2 \\pi k h r}{\\mu} \\frac {\\partial p}{\\partial r}$$",
              "page": 76,
              "kind": "observation"
            },
            {
              "claim_id": "geo.test_dake.s5_2.03.c03",
              "quote": "$$\\frac {1}{r} \\frac {\\partial}{\\partial r} \\left(\\frac {k \\rho}{\\mu} r \\frac {\\partial p}{\\partial r}\\right) = \\phi \\frac {\\partial \\rho}{\\partial t} \\tag {5.3}$$",
              "page": 76,
              "kind": "observation"
            }
          ]
        }
      ]
