      "id": "how",
      "kind": "how",
      "title": "Как это работает",
      "by": "mixed",
      "pages": [
        87,
        88
      ],
      "items": [
        {
          "id": "how-1",
          "section": "Как работает модель",
          "text": "**Переменная подобия**: Комбинация исходных переменных, позволяющая описать решения общей формой. Для решения автор использует преобразование Больцмана. При том же времени **переменная подобия** растёт с квадратом радиуса. При том же радиусе она обратно пропорциональна времени и пьезопроводности.",
          "claim_ids": [
            "geo.test_dake.s7_3.02.c01",
            "geo.test_dake.s7_3.02.c02"
          ],
          "pages": [
            87
          ],
          "by": "author",
          "quotes": [
            {
              "claim_id": "geo.test_dake.s7_3.02.c01",
              "quote": "can be solved by making use of Boltzmann's transformation",
              "page": 87,
              "kind": "observation"
            },
            {
              "claim_id": "geo.test_dake.s7_3.02.c02",
              "quote": "$$s = \\frac{r^2}{4(\\text{Diffusivity constant})t} = \\frac{\\phi \\mu c r^2}{4kt}$$",
              "page": 87,
              "kind": "observation"
            }
          ]
        },
        {
          "id": "how-2",
          "section": "Математика и наблюдения",
          "text": "Пространственная производная новой переменной пропорциональна радиусу. Временная производная отрицательна и обратно пропорциональна квадрату времени. После подстановки остаётся обыкновенное дифференциальное уравнение по переменной подобия.",
          "claim_ids": [
            "geo.test_dake.s7_3.02.c03",
            "geo.test_dake.s7_3.02.c04",
            "geo.test_dake.s7_3.02.c05"
          ],
          "pages": [
            87,
            88
          ],
          "by": "author",
          "quotes": [
            {
              "claim_id": "geo.test_dake.s7_3.02.c03",
              "quote": "$$\\frac{\\partial s}{\\partial r} = \\frac{\\phi \\mu c r}{2kt} \\tag{7.2}$$",
              "page": 87,
              "kind": "observation"
            },
            {
              "claim_id": "geo.test_dake.s7_3.02.c04",
              "quote": "$$\\frac{\\partial s}{\\partial t} = - \\frac{\\phi \\mu c r^2}{4kt^2} \\tag{7.3}$$",
              "page": 87,
              "kind": "observation"
            },
            {
              "claim_id": "geo.test_dake.s7_3.02.c05",
              "quote": "$$\\frac{d}{ds} \\left( s \\frac{dp}{ds} \\right) = -s \\frac{dp}{ds}$$",
              "page": 88,
              "kind": "observation"
            }
          ]
        }
      ]
    },
