{
  "node_id": "geo.basniev.s5_1.04",
  "chapter": "basniev",
  "index": 18,
  "part": {
    "id": "part2",
    "title": "От баланса массы к форме профиля давления"
  },
  "title_beginner": "Как меняются частные производные",
  "title_book": "Прямолинейно-параллельный фильтрационный поток упругой жидкости",
  "section": "s5_1",
  "pages": [
    482,
