            "geo.basniev.s5_1.15.c04"
          ],
          "pages": [
            487
          ],
          "by": "author",
          "quotes": [
            {
              "claim_id": "geo.basniev.s5_1.15.c04",
              "quote": "Раскрывая ее по правилу Лопиталя, можно показать",
              "page": 487,
              "kind": "inference"
            }
          ]
        },
        {
          "id": "how-5",
          "section": "Раскрытие неопределённости",
          "text": "Результат: вдали это произведение стремится к нулю.",
          "claim_ids": [
            "geo.basniev.s5_1.15.c05"
          ],
          "pages": [
            488
          ],
          "by": "author",
          "quotes": [
            {
              "claim_id": "geo.basniev.s5_1.15.c05",
              "quote": "это произведение стремится к нулю.",
              "page": 488,
              "kind": "inference"
            }
          ]
        },
        {
          "id": "how-6",
          "section": "Раскрытие неопределённости",
          "text": "Экспонента с отрицательным квадратом расстояния в показателе тоже стремится к нулю.",
