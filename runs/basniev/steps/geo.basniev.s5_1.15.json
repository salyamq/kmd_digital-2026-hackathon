        {
          "term": "Галерея",
          "definition": "Линейная выработка, через которую в этой задаче отбирают жидкость из пласта.",
          "en": "gallery",
          "page": null,
          "by": "model"
        },
        {
          "term": "Контурное давление",
          "definition": "В этой задаче — давление вдали от работающей галереи.",
          "en": "far-field pressure",
          "page": null,
          "by": "model"
        },
        {
          "term": "Дебит",
          "definition": "Объём жидкости, отбираемый за единицу времени.",
          "en": "volumetric flow rate",
          "page": null,
          "by": "model"
        },
        {
          "term": "Функция ошибок",
          "definition": "Нормированный интеграл функции вида e в степени минус квадрат; здесь описывает безразмерный профиль давления.",
          "en": "error function",
          "page": null,
          "by": "model"
        },
        {
          "term": "Правило Лопиталя",
          "definition": "Приём вычисления некоторых неопределённых пределов отношения через отношение производных.",
          "en": "L’Hôpital’s rule",
          "page": null,
          "by": "model"
        },
        {
          "term": "Пьезопроводность",
          "definition": "Способность среды передавать изменения давления диффузионным образом; коэффициент имеет размерность площади, делённой на время.",
          "en": "hydraulic diffusivity",
          "page": null,
          "by": "model"
        },
        {
          "term": "Скорость фильтрации",
          "definition": "Отношение объёмного расхода к полной площади поперечного сечения среды.",
          "en": "Darcy velocity",
          "page": null,
          "by": "model"
        },
        {
          "term": "Проницаемость",
          "definition": "Свойство пористой среды пропускать жидкость под действием перепада давления.",
          "en": "permeability",
          "page": null,
