    {
      "id": "glossary",
      "kind": "glossary",
      "title": "Новые понятия",
      "by": "mixed",
      "pages": [],
      "items": [
        {
          "term": "Пьезопроводность",
          "definition": "Способность среды передавать изменения давления диффузионным образом; коэффициент имеет размерность площади, делённой на время.",
          "en": "hydraulic diffusivity",
          "page": null,
          "by": "model"
        },
        {
          "term": "Закон Дарси",
          "definition": "Связывает скорость фильтрации с градиентом давления, проницаемостью и вязкостью; знак зависит от направления отсчёта.",
          "en": "Darcy’s law",
          "page": null,
          "by": "model"
        },
        {
          "term": "Градиент давления",
          "definition": "В одномерной задаче — производная давления по расстоянию, то есть изменение давления на единицу длины.",
          "en": "pressure gradient",
          "page": null,
          "by": "model"
        },
        {
          "term": "Скорость фильтрации",
          "definition": "Отношение объёмного расхода к полной площади поперечного сечения среды.",
          "en": "Darcy velocity",
          "page": null,
          "by": "model"
        },
        {
          "term": "Проницаемость",
          "definition": "Свойство пористой среды пропускать жидкость под действием перепада давления.",
          "en": "permeability",
          "page": null,
          "by": "model"
        },
        {
          "term": "Уравнение в частных производных",
          "definition": "Уравнение с производными от функции нескольких аргументов.",
          "en": "partial differential equation",
          "page": null,
          "by": "model"
        }
      ]
    }
