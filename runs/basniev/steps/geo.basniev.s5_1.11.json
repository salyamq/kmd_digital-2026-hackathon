          ]
        },
        {
          "text": "Продифференцируйте по координате и переставьте производные.",
          "claim_ids": [
            "geo.basniev.s5_1.11.c02",
            "geo.basniev.s5_1.11.c03"
          ],
          "pages": [
            486
          ]
        },
        {
          "text": "Подставьте определение скорости фильтрации.",
          "claim_ids": [
            "geo.basniev.s5_1.11.c04"
          ],
          "pages": [
            486
          ]
        }
      ]
    },
