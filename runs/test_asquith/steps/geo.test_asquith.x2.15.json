  "blocks": [
    {
      "id": "how",
      "kind": "how",
      "title": "Как это работает",
      "by": "mixed",
      "pages": [
        135
      ],
      "items": [
        {
          "id": "how-1",
          "section": "Два способа",
          "text": "Авторы оценивают **проницаемость**, способность породы пропускать флюид, по диаграмме или формуле. Результат выражают в **миллидарси**, единицах проницаемости.",
          "claim_ids": [
            "geo.test_asquith.x2.15.c01",
            "geo.test_asquith.x2.15.c04"
          ],
          "pages": [
            135
          ],
          "by": "author",
          "quotes": [
            {
              "claim_id": "geo.test_asquith.x2.15.c01",
              "quote": "This method for determining permeability utilizes a chart (Figure 7.8) or the two forms of the following formula:",
              "page": 135,
              "kind": "observation"
            },
            {
              "claim_id": "geo.test_asquith.x2.15.c04",
              "quote": "$K =$ permeability in millidarcys",
              "page": 135,
              "kind": "observation"
            }
          ]
        },
        {
          "id": "how-2",
          "section": "Что входит в формулу",
          "text": "Символ φ обозначает пористость, долю пор. Для нефти средней плотности коэффициент равен 250. Для сухого газа коэффициент равен 79. Куб пористости делят на неснижаемую водонасыщенность. **Неснижаемая водонасыщенность** здесь означает состояние, когда удерживаемая породой вода не вытесняется. Полученное отношение умножают на коэффициент. Затем возводят всё произведение в квадрат.",
          "claim_ids": [
            "geo.test_asquith.x2.15.c02",
            "geo.test_asquith.x2.15.c03",
            "geo.test_asquith.x2.15.c05",
            "geo.test_asquith.x2.15.c06"
          ],
          "pages": [
            135
          ],
          "by": "author",
          "quotes": [
            {
              "claim_id": "geo.test_asquith.x2.15.c02",
              "quote": "$$\nK = \\left( 250 \\times \\frac{\\phi^3}{S_{\\text{wirr}}} \\right)^2 \\text{ (medium-gravity oils)} \\tag{7.30}\n$$",
              "page": 135,
              "kind": "assumption"
            },
            {
              "claim_id": "geo.test_asquith.x2.15.c03",
              "quote": "$$\nK = \\left( 79 \\times \\frac{\\phi^3}{S_{\\text{wirr}}} \\right)^2 \\text{ dry gas)} \\tag{7.31}\n$$",
              "page": 135,
              "kind": "assumption"
            },
            {
              "claim_id": "geo.test_asquith.x2.15.c05",
              "quote": "$\\phi =$ porosity",
              "page": 135,
              "kind": "observation"
            },
            {
              "claim_id": "geo.test_asquith.x2.15.c06",
              "quote": "$S_{\\text{wirr}} =$ water saturation ($S_w$) of a zone at irreducible water saturation",
              "page": 135,
              "kind": "assumption"
            }
          ]
        }
      ]
    },
