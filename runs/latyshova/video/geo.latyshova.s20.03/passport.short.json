        96
      ]
    },
    "node_file_sha1": "4eff180eb9badd5b"
  },
  "script": [
    {
      "id": "L1",
      "role": "hook",
      "text": "Любая пористая порода — *коллектор*?",
      "t0": 0.25,
      "t1": 2.64,
      "sources": [],
      "asserts_fact": false
    },
    {
      "id": "L2",
      "role": "prediction",
      "text": "Как думаете, что *решает*, считать ли пласт коллектором?",
      "t0": 2.86,
      "t1": 6.278,
      "sources": [],
      "asserts_fact": false
    },
    {
      "id": "L3",
      "role": "reveal",
      "text": "Главный критерий — *критическое* значение проницаемости.",
      "t0": 6.883,
      "t1": 10.358,
      "sources": [
        {
          "type": "claim",
          "claim_id": "geo.latyshova.s20.03.c03",
          "page": 96,
          "quote": "является граничное или критическое значение коэффициента проницаемости"
        }
      ],
      "asserts_fact": true
    },
    {
      "id": "L4",
      "role": "mechanism",
      "text": "Этот порог зависит от *флюидов*, от самого коллектора в пласте и от рентабельного дебита района.",
      "t0": 10.578,
      "t1": 15.852,
      "sources": [
        {
          "type": "claim",
          "claim_id": "geo.latyshova.s20.03.c04",
          "page": 96,
          "quote": "Критическое значение проницаемости зависит от свойств флюидов и коллектора в пластовых условиях и от величины рентабельного дебита для данного района."
        }
      ],
      "asserts_fact": true
    },
    {
      "id": "L5",
      "role": "mechanism",
      "text": "Рентабельный дебит — тот, что выше *нижнего предела* для района.",
      "t0": 16.483,
      "t1": 20.218,
      "sources": [
        {
          "type": "claim",
          "claim_id": "geo.latyshova.s20.03.c06",
          "page": 96,
          "quote": "Рентабельным считают дебит нефти Qₙ или газа Qᵣ, значение которого выше нижнего предела"
        }
      ],
      "asserts_fact": true
    },
    {
      "id": "L6",
      "role": "mechanism",
      "text": "А предел задают геология, *экономика* района и себестоимость нефти или газа.",
      "t0": 20.438,
      "t1": 25.291,
      "sources": [
        {
          "type": "claim",
          "claim_id": "geo.latyshova.s20.03.c07",
          "page": 96,
          "quote": "определяются особенностями геологии, экономики данного района и себестоимостью тонны нефти или кубометра газа"
        }
      ],
      "asserts_fact": true
    },
    {
      "id": "L7",
      "role": "mechanism",
      "text": "Кроме порога проницаемости, есть и другие *косвенные* количественные признаки.",
      "t0": 25.917,
      "t1": 30.446,
      "sources": [
        {
          "type": "claim",
          "claim_id": "geo.latyshova.s20.03.c01",
          "page": 96,
          "quote": "Кроме прямых качественных, используются также косвенные количественные признаки коллекторов."
        }
      ],
      "asserts_fact": true
    },
    {
      "id": "L8",
      "role": "bridge",
      "text": "Для дата-инженера это *порог классификатора*, выбранный по экономике, а не только по точности.",
      "t0": 31.05,
      "t1": 36.673,
      "sources": [],
      "asserts_fact": false
    },
    {
      "id": "L9",
      "role": "bridge",
      "text": "Гипотеза: порог лучше хранить *параметром* по району и флюиду, а не зашивать в модель.",
      "t0": 36.893,
      "t1": 41.958,
      "sources": [],
      "asserts_fact": false
    },
    {
      "id": "L10",
      "role": "transfer",
      "text": "Себестоимость нефти в районе выросла. Куда сдвинется *граница* коллектора?",
      "t0": 42.178,
      "t1": 47.462,
      "sources": [],
      "asserts_fact": false
    }
  ],
