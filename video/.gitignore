# ---- secrets: never commit ------------------------------------------------
.env
*.env
.env.*
!.env.example
*.pem
*.key
credentials*.json

# ---- python / tooling ------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
