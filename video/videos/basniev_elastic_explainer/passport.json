    },
    "node_file_sha1": "49e60947f0dd4cbd"
  },
  "script": [
    {
      "id": "L1",
      "role": "hook",
      "text": "Скважину запустили. Кажется, давление сразу падает во всём пласте — будто это бак с водой.",
      "t0": 0.25,
      "t1": 6.942,
      "sources": [],
      "asserts_fact": false
    },
    {
      "id": "L2",
      "role": "prediction",
      "text": "Как думаете: через час после пуска почувствует ли это пласт в километре от скважины? Остановите видео и решите.",
      "t0": 7.162,
      "t1": 14.457,
      "sources": [],
      "asserts_fact": false
    },
    {
      "id": "L3",
      "role": "reveal",
      "text": "На самом деле возмущение давления уходит от скважины *постепенно* — с темпом, который задаёт пьезопроводность пласта.",
      "t0": 14.677,
      "t1": 22.801,
      "sources": [
        {
          "type": "claim",
          "claim_id": "c2",
          "page": null,
          "quote": null
        }
      ],
      "asserts_fact": true
    },
    {
      "id": "L4",
      "role": "mechanism",
      "text": "Почему так? При упругом режиме сжимаемы и жидкость, и сам пласт.",
      "t0": 23.417,
      "t1": 27.91,
      "sources": [
        {
          "type": "claim",
          "claim_id": "c1",
          "page": null,
          "quote": null
        }
      ],
      "asserts_fact": true
    },
    {
      "id": "L5",
      "role": "mechanism",
      "text": "Отбор жидкости покрывается тем, что она *расширяется*, а поровый объём пласта уменьшается.",
      "t0": 28.13,
      "t1": 34.509,
      "sources": [
        {
          "type": "claim",
          "claim_id": "c1",
          "page": null,
          "quote": null
        }
      ],
      "asserts_fact": true
    },
    {
      "id": "L6",
      "role": "mechanism",
      "text": "Поэтому давление подчиняется уравнению пьезопроводности. Его коэффициент *χ* — это проницаемость k, делённая на вязкость μ и упругоёмкость β*.",
      "t0": 35.117,
      "t1": 46.525,
      "sources": [
        {
          "type": "claim",
          "claim_id": "c2",
          "page": null,
          "quote": null
        }
      ],
      "asserts_fact": true
    },
    {
      "id": "L7",
      "role": "mechanism",
      "text": "А упругоёмкость складывает сжимаемость жидкости, умноженную на пористость, и сжимаемость самого пласта.",
      "t0": 46.745,
      "t1": 53.872,
      "sources": [
        {
          "type": "claim",
          "claim_id": "c3",
          "page": null,
          "quote": null
        }
      ],
      "asserts_fact": true
    },
    {
      "id": "L8",
      "role": "mechanism",
      "text": "Для скважины с постоянным дебитом в бесконечном пласте есть решение — *основная формула* теории упругого режима.",
      "t0": 54.092,
      "t1": 61.604,
      "sources": [
        {
          "type": "claim",
          "claim_id": "c4",
          "page": null,
          "quote": null
        }
      ],
      "asserts_fact": true
    },
    {
      "id": "L9",
      "role": "mechanism",
      "text": "Посчитаем её на сетке и посмотрим на пласт сверху. Цвет показывает, на сколько упало давление.",
      "t0": 62.217,
      "t1": 69.052,
      "sources": [],
      "asserts_fact": false
    },
    {
      "id": "L10",
      "role": "mechanism",
      "text": "Возмущение расходится от скважины, и граница заметного падения уходит всё дальше — но *не мгновенно*.",
      "t0": 69.272,
      "t1": 76.306,
      "sources": [
        {
          "type": "claim",
          "claim_id": "c2",
          "page": null,
          "quote": null
        }
      ],
      "asserts_fact": true
    },
    {
      "id": "L11",
      "role": "mechanism",
      "text": "Справа — профиль давления по радиусу из той же расчётной сетки, поэтому фронт на карте и на графике совпадает.",
      "t0": 76.526,
      "t1": 84.105,
      "sources": [],
      "asserts_fact": false
    },
    {
      "id": "L12",
      "role": "mechanism",
      "text": "Когда r²/(4χt) мало, понижение давления растёт пропорционально *логарифму* времени.",
      "t0": 84.717,
      "t1": 92.561,
      "sources": [
        {
          "type": "claim",
          "claim_id": "c5",
          "page": null,
          "quote": null
        }
      ],
      "asserts_fact": true
    },
    {
      "id": "L13",
      "role": "mechanism",
      "text": "В логарифмическом масштабе времени это почти *прямая* линия.",
      "t0": 92.781,
      "t1": 96.705,
      "sources": [
        {
          "type": "claim",
          "claim_id": "c5",
          "page": null,
          "quote": null
        }
      ],
      "asserts_fact": true
    },
    {
      "id": "L14",
      "role": "data",
      "text": "Как это выглядит в реальных данных? Вот забойное давление добывающей скважины месторождения Volve.",
      "t0": 97.317,
      "t1": 103.636,
      "sources": [
        {
          "type": "dataset",
          "dataset": "Equinor Volve",
          "file": "volve_daily_production.csv",
          "curve": "AVG_DOWNHOLE_PRESSURE"
        }
      ],
      "asserts_fact": true
    },
    {
      "id": "L15",
      "role": "data",
      "text": "Скважину остановили — и давление восстанавливается не скачком, а *постепенно*, день за днём. Это и есть кривая восстановления давления.",
      "t0": 103.856,
      "t1": 113.583,
      "sources": [
        {
          "type": "claim",
          "claim_id": "c5",
          "page": null,
          "quote": null
        },
        {
          "type": "dataset",
          "dataset": "Equinor Volve",
          "file": "volve_daily_production.csv",
          "curve": "ON_STREAM_HRS"
        }
      ],
      "asserts_fact": true
    },
    {
      "id": "L16",
      "role": "bridge",
      "text": "Для дата-инженера картина знакомая: изменение доходит до дальних узлов распределённой системы с задержкой.",
      "t0": 114.183,
      "t1": 121.097,
      "sources": [],
      "asserts_fact": false
    },
    {
      "id": "L17",
      "role": "bridge",
      "text": "А по форме отклика восстанавливают параметры: так по КВД оценивают свойства пласта. Подбор модели к кривой часто до сих пор делают вручную.",
      "t0": 121.317,
      "t1": 130.693,
      "sources": [],
      "asserts_fact": false
    },
    {
      "id": "L18",
      "role": "transfer",
      "text": "Проверьте себя: в пласте две скважины, одну остановили. Когда и как это заметят на второй?",
      "t0": 131.317,
      "t1": 137.515,
      "sources": [],
      "asserts_fact": false
    }
  ],
