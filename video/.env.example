# Copy to .env (same folder) and fill in what you use. .env is git-ignored; values are never printed or logged.

# --- TTS: Yandex SpeechKit (API v3) ---
YANDEX_API_KEY=
# Kazakhstan region: https://tts.api.ml.yandexcloud.kz   (default: https://tts.api.cloud.yandex.net)
YANDEX_TTS_ENDPOINT=
# optional alternatives to an API key
YANDEX_FOLDER_ID=
YANDEX_IAM_TOKEN=

# --- AI video for class D atmosphere clips (off by default: --ai-video none) ---
FAL_KEY=
VIDPIPE_VIDEO_MODEL=

# --- LLM planner (--planner llm / auto); one of the two ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# optional: model name, OpenAI-compatible base URL (OpenRouter, vLLM, Ollama http://localhost:11434/v1)
VIDPIPE_LLM_MODEL=
VIDPIPE_LLM_BASE_URL=
